DJANGO_SECRET_KEY=troque-por-uma-chave-forte
DOCUMENT_SIGNING_KEY=use-outra-chave-forte-e-exclusiva
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_COOKIES=0
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_PRELOAD=0
DJANGO_TRUST_PROXY_HEADERS=0
DJANGO_REQUIRE_SECURE_PRODUCTION=0
DJANGO_SESSION_AGE=3600
DJANGO_DB_PATH=/data/emeca.sqlite3
DJANGO_DATA_DIR=/data
GUNICORN_WORKERS=2

# Controle de acesso por módulo
DJANGO_RBAC_STRICT=1

# Proteção contra brute force e abuso
DJANGO_RATE_LIMIT_ENABLED=1
DJANGO_LOGIN_RATE_ACCOUNT=8
DJANGO_LOGIN_RATE_IP=30
DJANGO_LOGIN_RATE_WINDOW=900
DJANGO_BOLETIM_RATE_IP=10
DJANGO_BOLETIM_RATE_WINDOW=900
DJANGO_MATRICULA_RATE_IP=30
DJANGO_MATRICULA_RATE_WINDOW=3600
DJANGO_CONTATO_RATE_IP=20
DJANGO_CONTATO_RATE_WINDOW=900

# Integração WhatsApp via WA-AKG.
# No compose seguro recomendado, os containers conversam pela rede privada.
WA_AKG_BASE_URL=http://wa-akg-app:3000/api
WA_AKG_API_KEY=
WA_AKG_SESSION_ID=emeca-secretaria
WA_AKG_TIMEOUT_SECONDS=8
WA_AKG_BROADCAST_DELAY_MS=10000

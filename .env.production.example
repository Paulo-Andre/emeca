# Modelo para produção atrás de HTTPS/Cloudflare/Nginx.
# Não copie os segredos de exemplo: gere valores novos e exclusivos.
DJANGO_SECRET_KEY=gere-uma-chave-forte-e-unica
DOCUMENT_SIGNING_KEY=gere-outra-chave-forte-e-independente
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=escola.exemplo.br
DJANGO_CORS_ALLOWED_ORIGINS=https://escola.exemplo.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://escola.exemplo.br
DJANGO_SECURE_COOKIES=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_PRELOAD=0
DJANGO_TRUST_PROXY_HEADERS=1
DJANGO_REQUIRE_SECURE_PRODUCTION=1
DJANGO_SESSION_AGE=3600
DJANGO_DB_PATH=/data/emeca.sqlite3
DJANGO_DATA_DIR=/data
GUNICORN_WORKERS=2
DJANGO_RBAC_STRICT=1
DJANGO_RATE_LIMIT_ENABLED=1
DJANGO_LOGIN_RATE_ACCOUNT=8
DJANGO_LOGIN_RATE_IP=30
DJANGO_LOGIN_RATE_WINDOW=900
DJANGO_BOLETIM_RATE_IP=10
DJANGO_BOLETIM_RATE_WINDOW=900
DJANGO_MATRICULA_RATE_IP=30
DJANGO_MATRICULA_RATE_WINDOW=3600
DJANGO_CONTATO_RATE_IP=20
DJANGO_CONTATO_RATE_WINDOW=900

WA_AKG_BASE_URL=http://wa-akg-app:3000/api
WA_AKG_API_KEY=cole-a-chave-da-api-do-wa-akg
WA_AKG_SESSION_ID=emeca-secretaria
WA_AKG_TIMEOUT_SECONDS=8
WA_AKG_BROADCAST_DELAY_MS=10000

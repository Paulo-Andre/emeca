[Unit]
Description=Backup criptografado do EMECA
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/srv/projetos/emeca
EnvironmentFile=/etc/emeca/backup.env
ExecStart=/usr/bin/docker compose exec -T -e EMECA_BACKUP_PASSPHRASE -e EMECA_BACKUP_RETENTION_DAYS web python /app/scripts/backup_criptografado.py
